<% var title = 'Canva Education · Galaxy Admin'; var heading = 'Canva Education'; %>
<%- include('partials/header', { title: title, heading: heading, path: path, creditPills: [] }) %>
<style>
.cv-summary{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-bottom:26px;}
.cv-stat{background:#fff;border:1px solid #e8eaf0;border-radius:16px;padding:18px 20px;display:flex;flex-direction:column;gap:4px;position:relative;overflow:hidden;box-shadow:0 2px 8px rgba(99,102,241,.06);}
.cv-stat::before{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:linear-gradient(90deg,#6366f1,#8b5cf6);}
.cv-stat .sv{font-size:24px;font-weight:900;color:#1e1b4b;line-height:1.1;letter-spacing:-.4px;}
.cv-stat .sk{font-size:11px;text-transform:uppercase;letter-spacing:.07em;color:#9ca3af;font-weight:700;margin-top:3px;}
.cv-card{background:#fff;border:1px solid #e8eaf0;border-radius:18px;box-shadow:0 2px 12px rgba(0,0,0,.05);margin-bottom:20px;overflow:hidden;}
.cv-card-head{padding:16px 20px;border-bottom:1px solid #f0f0f6;display:flex;justify-content:space-between;align-items:center;gap:12px;background:linear-gradient(135deg,#fafbff,#fff);flex-wrap:wrap;}
.cv-card-head h3{margin:0;font-size:15px;font-weight:800;color:#1e1b4b;letter-spacing:-.2px;}
.cv-card-head .hint{font-size:12px;color:#9ca3af;font-weight:500;}
.cv-card-body{padding:20px;}
.cv-code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:38px;font-weight:900;letter-spacing:.08em;color:#1e1b4b;text-align:center;background:linear-gradient(135deg,#f5f3ff,#eef2ff);border:1px dashed #c7d2fe;border-radius:14px;padding:22px;}
.cv-exp{text-align:center;font-size:13px;color:#6b7280;margin-top:10px;}
.cv-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;}
.cv-btn{font-weight:700;font-size:13px;cursor:pointer;border:0;border-radius:10px;padding:9px 15px;background:linear-gradient(135deg,#6366f1,#8b5cf6);color:#fff;box-shadow:0 2px 8px rgba(99,102,241,.25);}
.cv-btn.ghost{background:#eef1f8;color:#3b4a6b;box-shadow:none;}
.cv-btn.sm{padding:6px 11px;font-size:12px;}
.cv-btn.safe{background:#ecfdf5;color:#059669;box-shadow:none;border:1px solid #a7f3d0;}
.cv-btn.danger{background:#fef2f2;color:#dc2626;box-shadow:none;border:1px solid #fecaca;}
.cv-btn:disabled{opacity:.5;cursor:default;}
.cv-inp{font-size:14px;padding:10px 12px;border:1px solid #e3e7f0;border-radius:10px;background:#fff;color:#1e1b4b;width:100%;}
.cv-inp:focus{outline:none;border-color:#8b5cf6;box-shadow:0 0 0 3px rgba(139,92,246,.12);}
textarea.cv-inp{min-height:150px;resize:vertical;font-size:13px;line-height:1.55;}
.cv-field{display:grid;grid-template-columns:1fr auto;gap:10px;}
.cv-note{font-size:12px;color:#9ca3af;margin-top:8px;}
table.cv-tbl{width:100%;border-collapse:collapse;font-size:13.5px;}
table.cv-tbl th{text-align:left;padding:9px 8px;border-bottom:1px solid #eef0f5;color:#9ca3af;font-size:11px;text-transform:uppercase;letter-spacing:.05em;font-weight:700;}
table.cv-tbl td{padding:10px 8px;border-bottom:1px solid #f4f5f9;vertical-align:middle;color:#374151;}
.cv-pill{font-size:10.5px;padding:2px 8px;border-radius:20px;background:#f3f4f6;color:#6b7280;font-weight:700;}
.cv-pill.order{background:#ecfdf5;color:#059669;}
.cv-empty{color:#9ca3af;font-size:13px;padding:16px 4px;text-align:center;}
.cv-pager{display:flex;gap:8px;align-items:center;justify-content:flex-end;margin-top:12px;font-size:12px;color:#6b7280;}
.cv-tabs{display:flex;gap:6px;}
.cv-tab{font-size:12px;font-weight:700;padding:6px 13px;border-radius:20px;cursor:pointer;border:1px solid #e3e7f0;background:#fff;color:#6b7280;}
.cv-tab.active{background:#1e1b4b;color:#fff;border-color:#1e1b4b;}
.cv-badge{font-size:11px;font-weight:700;padding:3px 9px;border-radius:20px;}
.cv-badge.ok{background:#ecfdf5;color:#059669;border:1px solid #a7f3d0;}
.cv-badge.warn{background:#fff7ed;color:#c2410c;border:1px solid #fed7aa;}
.cv-search{max-width:240px;}
.cv-toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%);background:#1e1b4b;color:#fff;padding:11px 18px;border-radius:11px;font-size:13px;font-weight:600;opacity:0;transition:.2s;pointer-events:none;z-index:9999;box-shadow:0 8px 24px rgba(30,27,75,.3);}
.cv-toast.show{opacity:1;}
.cv-toggle-wrap{display:inline-flex;align-items:center;gap:12px;cursor:pointer;user-select:none;}
.cv-toggle-wrap input{position:absolute;opacity:0;width:0;height:0;}
.cv-slider{width:48px;height:28px;border-radius:20px;background:#cbd2e0;position:relative;transition:.2s;flex:0 0 auto;}
.cv-slider::after{content:"";position:absolute;top:3px;left:3px;width:22px;height:22px;border-radius:50%;background:#fff;transition:.2s;box-shadow:0 1px 3px rgba(0,0,0,.3);}
.cv-toggle-wrap input:checked + .cv-slider{background:var(--ok);}
.cv-toggle-wrap input:checked + .cv-slider::after{transform:translateX(20px);}
.cv-toggle-wrap input:focus-visible + .cv-slider{outline:2px solid var(--accent);outline-offset:2px;}
.cv-toggle-label{font-weight:700;font-size:14.5px;}
.cv-prox-top{display:grid;grid-template-columns:auto 1fr auto;gap:18px;align-items:center;}
.cv-prox-big{font-size:26px;font-weight:900;color:#1e1b4b;line-height:1;}
.cv-prox-k{font-size:11px;color:#9ca3af;text-transform:uppercase;letter-spacing:.05em;font-weight:700;margin-top:3px;}
.cv-prox-bar-wrap{height:12px;background:#eef0f7;border-radius:8px;overflow:hidden;}
.cv-prox-bar{height:100%;width:0;background:linear-gradient(90deg,#10b981,#6366f1);transition:width .4s;}
.cv-prox-bar.warn{background:linear-gradient(90deg,#f59e0b,#ef4444);}
.cv-prox-meta{font-size:12px;color:#6b7280;margin-top:10px;}
@media(max-width:560px){.cv-code{font-size:28px;}.cv-field{grid-template-columns:1fr;}.cv-prox-top{grid-template-columns:1fr;gap:10px;}}
</style>

<div class="cv-summary">
  <div class="cv-stat"><div class="sv" id="cv-s-state">…</div><div class="sk">Account</div></div>
  <div class="cv-stat"><div class="sv" id="cv-s-code" style="font-family:ui-monospace,monospace;font-size:19px;">…</div><div class="sk">Live join code</div></div>
  <div class="cv-stat"><div class="sv" id="cv-s-members">—</div><div class="sk">In the team</div></div>
  <div class="cv-stat"><div class="sv" id="cv-s-unknown">—</div><div class="sk">Not on your list</div></div>
</div>

<div class="cv-card">
  <div class="cv-card-head"><h3>👤 Canva account</h3><span class="hint" id="cv-acct-state"></span></div>
  <div class="cv-card-body">
    <div class="cv-note">Codes and invites come from this Canva account. To switch: log into the new account in your browser, export its <b>canva.com</b> cookies (Cookie-Editor → Export → JSON), paste below, then Switch — the brand is detected automatically and new codes come from it.</div>
    <textarea class="cv-inp" id="cv-cookies" style="margin-top:10px;min-height:88px;" placeholder="Paste the exported canva.com cookies (JSON) here…"></textarea>
    <div class="cv-row" style="margin-top:8px;"><button class="cv-btn" onclick="cvSwitchAccount(this)">Switch account</button><span class="cv-note" id="cv-acct-msg" style="margin:0;"></span></div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head"><h3>⚙️ Automatic delivery</h3><span class="hint" id="cv-mode-hint"></span></div>
  <div class="cv-card-body">
    <label class="cv-toggle-wrap"><input type="checkbox" id="cv-enabled" onchange="cvToggleAuto(this)"><span class="cv-slider"></span><span class="cv-toggle-label" id="cv-toggle-label">Deliver Canva orders automatically</span></label>
    <div class="cv-note" id="cv-mode-note" style="margin-top:12px;"></div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head"><h3>🌐 Proxy monitor <span class="hint">IPRoyal residential bandwidth</span></h3><button class="cv-btn ghost sm" onclick="cvProxyTest(this)">Test connection</button></div>
  <div class="cv-card-body">
    <div class="cv-prox-top">
      <div><div class="cv-prox-big" id="cv-px-remain">—</div><div class="cv-prox-k">GB remaining</div></div>
      <div class="cv-prox-bar-wrap"><div class="cv-prox-bar" id="cv-px-bar"></div></div>
      <div style="text-align:right;"><div class="cv-prox-big" id="cv-px-days">—</div><div class="cv-prox-k">days left · at current rate</div></div>
    </div>
    <div class="cv-prox-meta" id="cv-px-meta"></div>
    <div class="cv-row" style="margin-top:12px;gap:8px;">
      <span class="cv-note" style="margin:0;">Quota (MB):</span>
      <input class="cv-inp" id="cv-px-quota" style="max-width:120px;" placeholder="2048">
      <button class="cv-btn ghost sm" onclick="cvSetQuota()">Save quota</button>
      <button class="cv-btn ghost sm" onclick="cvResetUsage()">Reset after top-up</button>
    </div>
    <table class="cv-tbl" style="margin-top:14px;"><thead><tr><th>Activity</th><th>When</th><th>Took</th><th>Data</th></tr></thead><tbody id="cv-px-log"><tr><td class="cv-empty" colspan="4">Loading…</td></tr></tbody></table>
    <div class="cv-pager" id="cv-px-pager"></div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head"><h3>🎟️ Join code</h3><span class="hint" id="cv-acct-line"></span></div>
  <div class="cv-card-body">
    <div class="cv-code" id="cv-code">…</div>
    <div class="cv-exp" id="cv-exp"></div>
    <div class="cv-row" style="margin-top:14px;justify-content:center;">
      <button class="cv-btn ghost sm" onclick="cvCopy(CV.code)">Copy code</button>
      <button class="cv-btn ghost sm" onclick="cvCopy(CV.link)">Copy join link</button>
      <button class="cv-btn sm" onclick="cvLoadCode(true)">Refresh code now</button>
    </div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head"><h3>✉️ Give the code to a customer</h3><span class="hint">adds them to your list + builds the message</span></div>
  <div class="cv-card-body">
    <div class="cv-field">
      <input class="cv-inp" id="cv-cust" placeholder="customer email — they must join with this exact email">
      <button class="cv-btn" onclick="cvBuildMsg()">Add + build message</button>
    </div>
    <textarea class="cv-inp" id="cv-msg" style="margin-top:12px;" placeholder="The ready-to-send message appears here…"></textarea>
    <div class="cv-row" style="margin-top:8px;"><button class="cv-btn ghost sm" onclick="cvCopy(document.getElementById('cv-msg').value)">Copy message</button></div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head">
    <h3>✅ Authorised emails <span class="cv-badge ok" id="cv-allow-count">0</span></h3>
    <input class="cv-inp cv-search" id="cv-allow-search" placeholder="Search…" oninput="cvRenderAllow()">
  </div>
  <div class="cv-card-body">
    <div class="cv-field">
      <input class="cv-inp" id="cv-add-email" placeholder="email to authorise (never auto-removed)">
      <button class="cv-btn ghost" onclick="cvAddAllow()">Add</button>
    </div>
    <div class="cv-note">Paid orders are added here automatically (1-year access). Manual adds never expire. Anyone on this list is never auto-removed while active.</div>
    <table class="cv-tbl" style="margin-top:14px;"><thead><tr><th>Email</th><th>From</th><th>Added</th><th>Access</th><th>Joined</th><th></th></tr></thead><tbody id="cv-allow-body"><tr><td class="cv-empty" colspan="6">Loading…</td></tr></tbody></table>
    <div class="cv-pager" id="cv-allow-pager"></div>
  </div>
</div>

<div class="cv-card">
  <div class="cv-card-head">
    <h3>👥 Team members</h3>
    <div class="cv-tabs"><span class="cv-tab active" id="cv-tab-unknown" onclick="cvTab('unknown')">Not on list</span><span class="cv-tab" id="cv-tab-all" onclick="cvTab('all')">All members</span></div>
  </div>
  <div class="cv-card-body">
    <div class="cv-row" style="gap:8px;flex-wrap:wrap;">
      <button class="cv-btn" id="cv-scan-btn" onclick="cvScan()">Scan team now</button>
      <button class="cv-btn ghost" onclick="cvProtectExisting()">Protect current members</button>
      <span style="flex:1;"></span>
      <input class="cv-inp cv-search" id="cv-scan-search" placeholder="Search…" oninput="cvRenderScan()">
    </div>
    <div class="cv-note" id="cv-scan-meta">Loading the team…</div>
    <div class="cv-note">Nothing is removed automatically — you tick who to remove and approve it. <b>Protect current members</b> adds everyone already on the account to your authorised list so your pre-automation members are never flagged.</div>
    <div id="cv-bulk" style="display:none;align-items:center;gap:10px;flex-wrap:wrap;margin:12px 0;padding:10px 12px;background:#f5f3ff;border:1px solid #ddd6fe;border-radius:12px;">
      <span id="cv-bulk-count" style="font-weight:700;color:#4c1d95;font-size:13px;"></span>
      <button class="cv-btn safe sm" onclick="cvBulkSafe()">Keep selected (mark safe)</button>
      <button class="cv-btn danger sm" onclick="cvBulkRemove()">Approve removal of selected</button>
      <span style="flex:1;"></span>
      <span class="cv-note" id="cv-queue-line" style="margin:0;"></span>
    </div>
    <table class="cv-tbl" style="margin-top:4px;"><thead><tr><th style="width:34px;"><input type="checkbox" id="cv-check-all" onclick="cvCheckAll(this)"></th><th>Email</th><th>Name</th><th>Role</th><th></th></tr></thead><tbody id="cv-scan-body"><tr><td class="cv-empty" colspan="5">—</td></tr></tbody></table>
    <div class="cv-pager" id="cv-scan-pager"></div>
  </div>
</div>

<div class="cv-toast" id="cv-toast"></div>

<%- include('partials/footer') %>
<script src="/js/canva.js?v=7"></script>
